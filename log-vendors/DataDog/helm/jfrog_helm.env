export DATADOG_API_KEY=DATADOG_API_KEY
export DATADOG_API_HOST=datadoghq.com
# Artifactory JPD URL of the format http://<ip_address>
export JPD_URL=http://abc.jfrog.io
# Artifactory username for authentication
export JPD_ADMIN_USERNAME=admin
# This flag should be set as true only for non-kubernetes installations or installations where JPD base URL is same to access both Artifactory and Xray (ex: https://sample_base_url/artifactory or https://sample_base_url/xray)
export COMMON_JPD=false
# The target observability platform. Supported platforms: [DATADOG, NEWRELIC, SPLUNK]
export TARGET_PLATFORM=SPLUNK
